module app;

use std::console;

struct User {
    id: int;
    name: string;
}

fn main(): int {
    let scores: map<string, int> = map {
        "Alex": 10,
        "Bob": 20
    };

    let users: map<string, User> = map {
        "alex": User { id: 1, name: "Alex" },
        "bob": User { id: 2, name: "Bob" }
    };

    let empty: map<string, int> = map {};

    console::println(scores);
    console::println(users);
    console::println(empty);

    return 0;
}