module app;

use std::console;

struct User {
    name: string;
    active: bool;
}

fn main(): int {
    let user: User = User {
        name: "Alex",
        active: true
    };

    console::println(user.name == "Alex");
    console::println(user.name != "Bob");
    console::println(user.active == true);
    console::println(user.active != false);

    return 0;
}