module app;

use std::array;
use std::console;

struct User {
    id: int;
    name: string;
}

fn main(): int {
    let ids: []int = [10, 20, 30];

    let names: []string = ["Alex", "Bob"];

    let users: []User = [
        User { id: 1, name: "Alex" },
        User { id: 2, name: "Bob" }
    ];

    console::println(array::len(ids));
    console::println(array::len(names));
    console::println(array::len(users));

    return 0;
}