module app;

use std::console;
use std::map;

struct User {
    id: int;
    name: string;
}

fn main(): int {
    let scores: map<string, int> = map {
        "Alex": 10,
        "Bob": 20
    };

    let users: map<string, User> = map {
        "alex": User { id: 1, name: "Alex" },
        "bob": User { id: 2, name: "Bob" }
    };

    let empty: map<string, int> = map {};

    var dynamic: map<string, int> = map {
        "first": 1
    };

    dynamic["second"] = 2;
    dynamic["third"] = 3;

    console::println(map::len(scores));
    console::println(map::len(users));
    console::println(map::len(empty));
    console::println(map::len(dynamic));

    return 0;
}