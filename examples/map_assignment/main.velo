module app;

use std::console;

fn main(): int {
    var scores: map<string, int> = map {
        "Alex": 10,
        "Bob": 20
    };

    scores["Bob"] = 42;
    scores["Carol"] = 30;

    var grouped: map<string, []int> = map {
        "a": [1, 2]
    };

    grouped["a"][0] = 99;

    var nested: map<string, map<string, int>> = map {
        "outer": map {
            "inner": 1
        }
    };

    nested["outer"]["inner"] = 77;

    console::println(scores["Bob"]);
    console::println(scores["Carol"]);
    console::println(grouped["a"][0]);
    console::println(nested["outer"]["inner"]);

    return 0;
}